PORT=3000

# Opção paga/oficial OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Opção grátis/freemium do Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opção grátis/freemium da Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Banco online gratis para manter contas/dados no Cloud Run
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=financeai_state
SUPABASE_ROW_ID=database

# Envio real de codigo por e-mail (facil para apresentacao com Gmail)
# No Gmail, crie uma "senha de app" e use ela em SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app-do-gmail
SMTP_FROM=seuemail@gmail.com
